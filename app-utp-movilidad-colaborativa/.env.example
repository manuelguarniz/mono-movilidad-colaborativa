# Copia este archivo como .env.local para cambiar la configuración en tu máquina.

# true (por defecto): API simulada con MSW.
# false: backend real en http://localhost:8080/api.
VITE_USE_MOCKS=true

# Solo si el backend está en otro host o puerto.
# VITE_API_BASE_URL=http://localhost:8080/api

# VITE_AUTH_COOKIE_NAME=app_auth_token
# VITE_AUTH_VERIFIED_COOKIE_NAME=app_auth_verified
