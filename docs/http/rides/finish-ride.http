# Finalizar mi viaje (conductor, RN-45)
# POST /rides/{rideId}/finish
#
# Requiere token SESSION. Sin cuerpo.

@baseUrl = http://localhost:8080/api
# token scope SESSION devuelto por POST /auth/verify-code (vence en 8 h)
@sessionToken = pega-aqui-el-token
@rideId = 6705a1f0c3d4e5f600000504

### 200 · Viaje completado; sus reservas EN_VIAJE pasan a COMPLETADA
# Respuesta 200 OK
# { "message": "Viaje completado" }
POST {{baseUrl}}/rides/{{rideId}}/finish
Authorization: Bearer {{sessionToken}}

### 409 · El viaje no está en curso
# { "code": "INVALID_STATUS", "message": "Este viaje no está en curso" }
