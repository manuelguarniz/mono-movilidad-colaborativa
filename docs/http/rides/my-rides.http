# Mis viajes del conductor (P17, 17-B) y resumen del dashboard (06-F)
# GET /rides/mine
#
# Requiere token SESSION.

@baseUrl = http://localhost:8080/api
# token scope SESSION devuelto por POST /auth/verify-code (vence en 8 h)
@sessionToken = pega-aqui-el-token

### 200 · Viajes publicados y en curso, con pasajeros, plazos y contador (RN-30)
# Respuesta 200 OK
# {
#   "data": [
#     {
#       "ride": { "id": "6705a1f0c3d4e5f600000504", "status": "PUBLISHED", "departureTime": "2026-10-29T19:20:00Z", "startedAt": null, "...": "resumen del viaje como en GET /rides" },
#       "passengers": [
#         { "bookingId": "6705a1f0c3d4e5f600000601", "id": "6705a1f0c3d4e5f600000701", "name": "Lucía R.", "photoUrl": null, "rating": { "average": 4.8, "count": 12 }, "seats": 2, "totalCredits": 12, "status": "CONFIRMED" }
#       ],
#       "cancellableUntil": "2026-10-29T18:50:00Z",
#       "startableFrom": "2026-10-29T19:05:00Z",
#       "startableUntil": "2026-10-29T19:50:00Z"
#     }
#   ],
#   "cancellations": { "count": 3, "limit": 10, "windowDays": 30, "blockedUntil": null, "blockedUntilIfCancelled": null }
# }
GET {{baseUrl}}/rides/mine
Authorization: Bearer {{sessionToken}}
